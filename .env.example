# Copiar a .env y ajustar si hace falta
# La mayoría tiene valores por defecto que funcionan con docker compose

# ── Flask App ─────────────────────────────────────────────────────
OTEL_SERVICE_NAME=flask-otel-demo
SERVICE_VERSION=1.0.0
ENVIRONMENT=development
PORT=5000
DB_PATH=/tmp/app.db

# ── OTel Collector ────────────────────────────────────────────────
# Cambiar al endpoint de tu backend en producción:
# Azure Monitor: usar azuremonitor exporter con APPLICATIONINSIGHTS_CONNECTION_STRING
# Grafana Cloud:  usar otlp exporter con auth header
# AWS X-Ray:      usar awsxray exporter
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# ── Grafana ───────────────────────────────────────────────────────
# admin/admin para desarrollo — cambiar en producción
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
